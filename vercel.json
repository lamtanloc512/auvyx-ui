{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "python3 packages/docs/build.py",
  "outputDirectory": "packages/docs/out",
  "headers": [
    {
      "source": "/r/(.*)",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    }
  ]
}
